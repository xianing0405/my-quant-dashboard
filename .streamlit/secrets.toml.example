# Streamlit Cloud Secrets 模板（不含任何真实秘密）
#
# 使用方法：复制本文件为 .streamlit/secrets.toml 并填入真实值；
# 或在本机用同名环境变量（环境变量优先级高于 secrets）。
# 请勿把真实口令/密钥提交到公开 Git。

# ---- 管理身份（触发数据更新 / Wind 抓取 / 大模型调用）----
# 不配置 ADMIN_PASSWORD 时，更新按钮仅提示「需管理员」，访客为只读。
# ADMIN_PASSWORD = ""

# ---- 内部知识库访问认证 ----
# open：匿名可进（仅本地开发用）；password：需口令；disabled（默认）：不开放。
# 公网部署务必使用 password 或 disabled，不要设置 open。
# KNOWLEDGE_ACCESS_MODE = "disabled"
# KNOWLEDGE_ACCESS_PASSWORD = ""
# KNOWLEDGE_ALLOWED_USERS = ""      # 白名单（逗号分隔，可选）

# ---- 内部知识库持久化 ----
# 默认 local=本地 SQLite，属「试运行」，Streamlit 重启可能丢失；
# 需接入可靠云存储/托管数据库后才可视为持久化。
# KNOWLEDGE_MATERIALS_DIR = "core/knowledge/raw_docs"
# KNOWLEDGE_STORE_DIR = "core/knowledge/store"
# KNOWLEDGE_STORAGE_BACKEND = "local"

# ---- 大模型接口（Anthropic 兼容 /v1/messages）----
# ANTHROPIC_AUTH_TOKEN = ""         # 或 ANTHROPIC_API_KEY
# ANTHROPIC_BASE_URL = "https://api.deepseek.com/anthropic"
# ANTHROPIC_DEFAULT_HAIKU_MODEL = "deepseek-v4-pro"

# ---- 语义检索（可选；未配置则仅关键词检索）----
# EMBEDDING_API_KEY = ""
# EMBEDDING_BASE_URL = ""
# EMBEDDING_MODEL = ""
