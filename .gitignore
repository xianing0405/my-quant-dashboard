# 密钥与本地配置
.env
.env.*
!.env.example
*.key
*.pem
secrets.*
.local/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 系统
.DS_Store

# ===== 内部知识库（机密材料，绝不进入版本库）=====
# 原始内部材料（研报 / 会议纪要等）仅保留目录结构，正文文件一律忽略
core/knowledge/raw_docs/*
!core/knowledge/raw_docs/.gitkeep
!core/knowledge/raw_docs/README.md

# 检索索引（含内部材料解码正文，同属机密）仅保留目录结构，索引文件一律忽略
core/knowledge/index/*
!core/knowledge/index/.gitkeep

# 内部知识库持久化存储（SQLite：文档元数据 + 解码片段 + 观点/点评，含内部材料正文）
core/knowledge/store/

# 测试夹具（本地测试生成的 PDF/DOCX 等，不进入版本库）
tests/fixtures/

# Wind 来源数据（付费数据，公开权限未确认，不进入公开仓库）
core/macro/reports/
data/dynamic_concepts_cache.json
